Screen {
    layout: vertical;
}

#banner {
    height: 1;
    padding: 0 1;
    background: $error 30%;
    color: $text;
}

#strip {
    height: 1;
    padding: 0 1;
    background: $surface;
    color: $text;
}

#tabs {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}

/* Conversation */

#conversation-view {
    height: 1fr;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-align: left;
    padding: 0 1;
}

#conversation-view .turn {
    padding: 0 1;
    margin-bottom: 1;
    border-left: wide $primary 60%;
}

#conversation-view .turn.alt {
    background: $boost;
}

#conversation-view .turn.interrupted {
    border-left: wide $error;
}

/* Latency */

#latency-view {
    height: 1fr;
}

#latency-bars {
    height: 1fr;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

#latency-legend {
    height: auto;
    max-height: 12;
    border: round $primary;
    border-title-color: $secondary;
    padding: 0 1;
}

#speaking-timeline {
    height: 8;
    border-subtitle-align: left;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

/* Workers */

#workers-view {
    height: 1fr;
}

#workers-top {
    height: 2fr;
}

#worker-tree {
    width: 2fr;
    height: 100%;
    border: round $primary;
    border-title-color: $secondary;
    padding: 0 1;
}

#jobs-table {
    width: 3fr;
    height: 100%;
    border: round $primary;
    border-title-color: $secondary;
}

#bus-feed {
    height: 3fr;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

/* Metrics */

#metrics-view {
    height: 1fr;
}

#metrics-top {
    height: 2fr;
}

#latency-chart {
    width: 3fr;
    border: round $primary;
    border-title-color: $secondary;
}

#series {
    width: 1fr;
    height: 100%;
    border: round $primary;
    border-title-color: $secondary;
}

#summary-table {
    height: 1fr;
    border: round $primary;
    border-title-color: $secondary;
}

#startup {
    height: auto;
    max-height: 40%;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
    overflow-y: auto;
}

/* Logs */

#logs-view {
    height: 1fr;
}

#log-toolbar {
    height: auto;
}

#log-search {
    width: 1fr;
}

#log-lines {
    height: 1fr;
    border: round $primary;
    border-title-color: $secondary;
    border-subtitle-color: $text-muted;
    padding: 0 1;
}

#log-pinned {
    height: 1;
    padding: 0 1;
    background: $surface;
}
